# These belong in Supabase secrets, never in the repo.
serviceAccountKey.json
*-firebase-adminsdk-*.json

# Supabase CLI local state (linked project ref, cached version).
supabase/.temp/

# Large binaries, APKs, test artifacts
*.apk
*.aab
*.ipa
LikhAI.apk

# Temporary development & scratch scripts
scratch/

