{
  "expo": {
    "name": "LikhAI",
    "slug": "LikhAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/likhoralogo.png",
    "scheme": "likhai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/likhoralogo.png"
    },
    "android": {
      "package": "com.company.likhoraai",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7",
        "foregroundImage": "./assets/images/likhoralogo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/likhoralogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF7",
          "image": "./assets/images/likhoralogo.png",
          "imageWidth": 120
        }
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Likhora AI uses your location to find accurate, nearby wholesale suppliers and marketplaces."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Likhora AI needs access to your photo library to select photos for products and profile avatars."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
