{
  "expo": {
    "name": "LikhAI",
    "slug": "LikhAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/likhoralogo.png",
    "scheme": "likhai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/likhoralogo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7",
        "foregroundImage": "./assets/images/likhoralogo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/likhoralogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF7",
          "image": "./assets/images/likhoralogo.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
